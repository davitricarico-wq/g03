# Backend (src/geoRisco)
# Local: copie para .env. Produção (Vercel): defina no painel Environment Variables.

PORT=3000
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
SUPABASE_URL=https://<seu-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # NUNCA expor no frontend
SUPABASE_STORAGE_BUCKET=georisco-fotos

# Somente produção / Vercel:
# CORS_ORIGIN=https://<url-do-gitlab-pages>     # origens permitidas (separadas por vírgula)
# PG_POOL_MAX=2                                  # mantenha baixo em serverless
# PGSSL=true                                     # liga sozinho quando NODE_ENV=production
